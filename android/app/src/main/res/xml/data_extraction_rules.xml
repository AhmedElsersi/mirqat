<?xml version="1.0" encoding="utf-8"?>
<!-- The same rule for Android 12 and up, where cloud backup and device-to-device
     transfer are configured separately. See backup_rules.xml for why. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="audio/" />
        <exclude domain="file" path="images/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="audio/" />
        <exclude domain="file" path="images/" />
    </device-transfer>
</data-extraction-rules>
