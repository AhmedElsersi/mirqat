/* The Arabic display name. These per-locale overrides win over
   CFBundleDisplayName in Info.plist, so the name has to be correct here
   too — editing only Info.plist leaves the old name on every locale that
   has an .lproj. */
"CFBundleDisplayName" = "اقرأ وارتق";
"CFBundleName" = "اقرأ وارتق";

/* Never shown. The download library the app includes can save to Photos, and
   Apple's upload scan requires a purpose string for any binary that references
   the Photos classes — even though this app never calls that part of it, and
   the permission request itself is compiled out (see the Podfile). */
"NSPhotoLibraryAddUsageDescription" = "لا يستخدم التطبيق مكتبة الصور.";
"NSPhotoLibraryUsageDescription" = "لا يستخدم التطبيق مكتبة الصور.";
