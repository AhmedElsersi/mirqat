/android/app/release

# Play upload-key material. Generated by tool/make_upload_key.sh (or written
# from secrets by .github/workflows/release.yml); it must never be
# committed — anyone with the keystore + password can sign updates to this
# app under its applicationId.
android/key.properties
android/app/upload-keystore.jks
**/*.jks
**/*.keystore

# Google Play service-account credential. Grants CI's upload step Play
# Console access; treat it like any other private key.
**/play-service-account.json

admin.env
data/work/